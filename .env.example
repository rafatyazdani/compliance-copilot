# ── LLM Backend ────────────────────────────────────────────────────────────
# "anthropic" (default) or "ollama"
LLM_BACKEND=anthropic

# ── Anthropic ───────────────────────────────────────────────────────────────
# Get your key at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_key_here

# Model options (cheapest → most capable):
#   claude-haiku-4-5-20251001   ← default, fast, cheap
#   claude-sonnet-4-6           ← better reasoning, higher cost
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Ollama (local) ──────────────────────────────────────────────────────────
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:  ollama pull llama3.1:8b
# 3. Set LLM_BACKEND=ollama above
# 4. pip install openai  (Ollama uses OpenAI-compatible API)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
